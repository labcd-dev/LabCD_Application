# LLM / search provider keys (set at least one you use)
NVIDIA_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Auth — change JWT_SECRET and ADMIN_PASSWORD before going live
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@labcd.ai
ADMIN_PASSWORD=change-me-strong-password

# Public URLs (API is proxied at /api/ on the same host)
APP_PUBLIC_URL=https://app.labcd.ai
API_PUBLIC_URL=https://app.labcd.ai

# CORS — production origin for app.labcd.ai
CORS_ORIGINS=https://app.labcd.ai

# DB pool / API concurrency (optional; raise if login stalls under job load)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# API_THREAD_LIMIT=64

# PostgreSQL — change POSTGRES_PASSWORD before going live
POSTGRES_USER=labcd
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=labcd

# Paths inside containers (compose also sets these for the api service)
RESULTS_DIR=/app/results
UPLOADS_DIR=/app/uploads

# Telegram daily analytics digest (optional seed; prefer Admin → Analytics)
# Leave empty to log digests to the API console instead of sending
TELEGRAM_BOT_TOKEN=

# DATABASE_URL is overridden in docker-compose.prod.yml for the api service.
# Optional local reference:
# DATABASE_URL=postgresql+psycopg://labcd:PASSWORD@db:5432/labcd
