# LLM / search provider keys (set at least one you use)
NVIDIA_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# FastAPI backend
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RESULTS_DIR=results
UPLOADS_DIR=uploads

# PostgreSQL
POSTGRES_USER=labcd
POSTGRES_PASSWORD=labcd
POSTGRES_DB=labcd
POSTGRES_PORT=5432
# Local (API on host): use localhost. Docker Compose overrides this for the api service.
DATABASE_URL=postgresql+psycopg://labcd:labcd@localhost:5432/labcd

# Auth (change JWT_SECRET and ADMIN_PASSWORD in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
APP_PUBLIC_URL=http://localhost:5173

# Email (leave SMTP_HOST empty to log messages to the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@labcd.local
# EMAIL_VERIFY_EXPIRE_HOURS=24
# EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=120
# PASSWORD_RESET_EXPIRE_HOURS=1
# LOGIN_FAIL_WINDOW_SECONDS=60
# LOGIN_FAIL_MAX_ATTEMPTS=3
# LOGIN_LOCKOUT_MINUTES=10

# DB pool / API concurrency (optional; defaults shown)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# API_THREAD_LIMIT=64
